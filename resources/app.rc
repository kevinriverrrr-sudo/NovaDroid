// NovaDroid Launcher resources
#include <windows.h>

1 ICON "icon.ico"

1 VERSIONINFO
FILEVERSION     0,4,0,0
PRODUCTVERSION  0,4,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "NovaDroid Project"
      VALUE "FileDescription",  "NovaDroid Emulator Launcher"
      VALUE "FileVersion",      "0.4.0.0"
      VALUE "InternalName",     "NovaDroidLauncher"
      VALUE "LegalCopyright",   "MIT License (c) NovaDroid Project"
      VALUE "OriginalFilename", "NovaDroidLauncher.exe"
      VALUE "ProductName",      "NovaDroid Emulator"
      VALUE "ProductVersion",   "0.4.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

1 24 "app.manifest"
